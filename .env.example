# ---------------------------------------------------------------------------
# Modele de configuration (copier dans .env en local, et declarer dans
# Vercel -> Settings -> Environment Variables pour la production)
# ---------------------------------------------------------------------------

# Base de donnees MySQL / TiDB Cloud (TLS obligatoire pour TiDB)
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:4000/gestion_presences?sslaccept=strict&connect_timeout=15&connection_limit=5&pool_timeout=20"

# Auth.js v5
# Generer le secret avec : npx auth secret (ou openssl rand -base64 32)
AUTH_SECRET="changez-cette-cle-secrete"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Compatibilite NextAuth v4
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changez-cette-cle-secrete"
AUTH_MAX_AGE=86400
